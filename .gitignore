# Local Go builds (keep source directories and qualification evidence visible)
/bin/
/dist/
/alan
/alan-resource
/alan-evidence
/alan-investigate
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# Local test coverage and profiling output
/coverage/
/coverage.out
/coverage.html
/coverage.*.out
*.coverprofile
profile.cov
*.prof
*.pprof

# Local Go workspace overrides
go.work
go.work.sum

# Runtime SQLite stores and their journal, WAL, shared-memory and lock files
*.sqlite
*.sqlite-*
*.sqlite.lock
*.sqlite3
*.sqlite3-*
*.sqlite3.lock
*.db
*.db-*
*.db.lock

# Retained qualification evidence belongs in version control
!docs/foundational/**/*.sqlite
!docs/foundational/**/*.sqlite3
!docs/foundational/**/*.db

# Local credentials and environment overrides; keep example configs available
.env
.env.*
!.env.example
!.env.sample
!.env.template
.direnv/

# Local editor and operating-system files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
._*

# Local repository notes
/repo.md

# LaTeX build artifacts
*.aux
*.log
*.bbl
*.xdv
*.synctex.gz
